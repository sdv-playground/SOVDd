            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          },
          "409": {
            "description": "Not in the execute phase, or already committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          }
        }
      }
    },
    "/components/{component_id}/updates/{update_id}/x-update-finish": {
      "parameters": [
        {
          "name": "component_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "update_id",
          "in": "path",
          "required": true,
          "description": "The id the client registered.",
          "schema": {
            "$ref": "#/components/schemas/UpdateId"
          }
        }
      ],
      "put": {
        "summary": "Clean up a settled update",
        "description": "From `COMMITTED`, `ROLLED_BACK` or `FATAL_FAILURE`; the update goes through `CLEANING_UP` to `IDLE` and then only awaits its `DELETE`.",
        "responses": {
          "202": {
            "description": "Accepted; poll the status resource until the state settles.",
            "headers": {
              "Location": {
                "description": "`…/updates/{update_id}/status`, under the prefix the request used.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown update",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          },
          "409": {
            "description": "Not settled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          }
        }
      }
    },
    "/components/{component_id}/updates/{update_id}/x-update-invalidate": {
      "parameters": [
        {
          "name": "component_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "update_id",
          "in": "path",
          "required": true,
          "description": "The id the client registered.",
          "schema": {
            "$ref": "#/components/schemas/UpdateId"
          }
        }
      ],
      "put": {
        "summary": "Discard a preparation",
        "description": "From `VALIDATED`; the update returns to `PROCESSED` and can be prepared again.",
        "responses": {
          "202": {
            "description": "Accepted; poll the status resource until the state settles.",
            "headers": {
              "Location": {
                "description": "`…/updates/{update_id}/status`, under the prefix the request used.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown update",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          },
          "409": {
            "description": "Not `VALIDATED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}$",
        "description": "Chosen by the client, 1-64 characters, not starting with `.`. The server stores and reports it verbatim."
      },
      "UpdateList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateId"
            }
          }
        }
      },
      "Registration": {
        "type": "object",
        "required": [
          "id",
          "x-update"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UpdateId"
          },
          "target": {
            "type": "string",
            "description": "The executor (component) the update is for."
          },
          "x-update": {
            "$ref": "./sovd-x-update.schema.json#/$defs/RegistrationOptions"
          }
        }
      },
      "Details": {
        "type": "object",
        "description": "Standard §7.18.3 details; only the x-update member is shown.",
        "properties": {
          "x-update": {
            "type": "object",
            "required": [
              "target",
              "two_phase"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "two_phase": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "StatusBody": {
        "type": "object",
        "required": [
          "phase",
          "status",
          "x-update"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "prepare",
              "execute"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "inProgress",
              "completed",
              "failed"
            ]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "step": {
            "type": "string",
            "description": "Free text for people; not for decisions."
          },
          "error": {
            "$ref": "#/components/schemas/GenericError"
          },
          "x-update": {
            "allOf": [
              {
                "$ref": "./sovd-x-update.schema.json#/$defs/Status"
              }
            ],
            "properties": {
              "state": {
                "$ref": "#/components/schemas/XUpdateState"
              }
            }
          }
        }
      },
      "XUpdateState": {
        "allOf": [
          {
            "$ref": "./sovd-x-update.schema.json#/$defs/State"
          }
        ],
        "description": "The state of the update, one value of the shared `State` enum. A client compares this value and nothing else; `phase`/`status` stay the standard members and do not encode the x-update state.\n\nSettled states, where the update stays until the client acts (or, for `ACTIVATING`, until a restart happens):\n- `VALIDATED`: prepared. Next: `execute`, `x-update-invalidate`, or `DELETE`.\n- `ACTIVATED_UNCOMMITTED`: the new software runs and awaits a verdict. Next: `x-update-commit` or `x-update-rollback`.\n- `COMMITTED`: committed. Next: `x-update-finish`.\n- `ROLLED_BACK`: rolled back, whether the client asked for it or the executor rolled back on its own (auto-rollback, e.g. the new software did not come up). Next: `x-update-finish`.\n- `FATAL_FAILURE`: the executor cannot continue the update. Next: `x-update-finish` or `DELETE`.\n- `IDLE` with `status: completed`: finished. Next: `DELETE`. (`IDLE` before preparation means the executor has not taken the update yet.)\n\nTransient states, which the client awaits: `READY`, `TRANSFERRING_META`, `PROCESSING`, `PROCESSED` (processed, not validated; also after `x-update-invalidate`), `VALIDATING`, `ACTIVATING`, `VERIFYING`, `COMMITTING`, `ROLLING_BACK`, `CLEANING_UP`.\n\nRestarts. An activation that needs a component or node restart stays in `ACTIVATING` (`step` may say why, e.g. `awaiting-ignition-cycle`) until the restart has happened, then passes `VERIFYING` to `ACTIVATED_UNCOMMITTED`. The client does not issue the restart and the server does not ask it to: the restart may come from the vehicle's state management, a tester or an ignition cycle. The client awaits the state."
      },
      "GenericError": {
        "type": "object",
        "description": "ISO 17978-3 §5.8.3 GenericError.",
        "required": [
          "error_code",
          "message"
        ],
        "properties": {
          "error_code": {
            "type": "string"
          },
          "vendor_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
